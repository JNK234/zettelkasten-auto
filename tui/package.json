{
  "name": "vault-tui",
  "version": "0.1.0",
  "description": "Terminal front-end for vaultengine (Ink + TypeScript), talking JSON-RPC over stdio",
  "type": "module",
  "bin": {
    "vault-tui": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "npm run gen:types:check && vitest run",
    "gen:types": "node scripts/gen-types.mjs",
    "start": "node dist/cli.js",
    "gen:types:check": "node scripts/gen-types.mjs --check",
    "test:e2e": "npm run build && vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "ink": "8.0.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "json-schema-to-typescript": "16.0.0",
    "node-pty": "1.1.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
