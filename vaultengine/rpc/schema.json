{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vaultengine:rpc",
  "title": "vaultengine JSON-RPC 2.0 API",
  "description": "JSON-RPC 2.0 over stdio: one UTF-8 JSON message per line, in both directions. Params are by-name objects. The root schema accepts a single message or a batch.",
  "anyOf": [
    {
      "anyOf": [
        {
          "$ref": "#/$defs/Request"
        },
        {
          "$ref": "#/$defs/Response"
        }
      ]
    },
    {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/Request"
          },
          {
            "$ref": "#/$defs/Response"
          }
        ]
      }
    }
  ],
  "x-methods": {
    "index.build": {
      "summary": "Create or incrementally update the index.",
      "params": {
        "$ref": "#/$defs/IndexBuildParams"
      },
      "result": {
        "$ref": "#/$defs/IndexBuildResult"
      },
      "request": {
        "$ref": "#/$defs/IndexBuildRequest"
      },
      "response": {
        "$ref": "#/$defs/IndexBuildResponse"
      }
    },
    "index.status": {
      "summary": "Whether the index exists and is up to date.",
      "params": {
        "$ref": "#/$defs/IndexStatusParams"
      },
      "result": {
        "$ref": "#/$defs/IndexStatusResult"
      },
      "request": {
        "$ref": "#/$defs/IndexStatusRequest"
      },
      "response": {
        "$ref": "#/$defs/IndexStatusResponse"
      }
    },
    "vault.stats": {
      "summary": "Summary numbers for the indexed vault.",
      "params": {
        "$ref": "#/$defs/VaultStatsParams"
      },
      "result": {
        "$ref": "#/$defs/VaultStatsResult"
      },
      "request": {
        "$ref": "#/$defs/VaultStatsRequest"
      },
      "response": {
        "$ref": "#/$defs/VaultStatsResponse"
      }
    },
    "health.report": {
      "summary": "Link and structure problems.",
      "params": {
        "$ref": "#/$defs/HealthReportParams"
      },
      "result": {
        "$ref": "#/$defs/HealthReportResult"
      },
      "request": {
        "$ref": "#/$defs/HealthReportRequest"
      },
      "response": {
        "$ref": "#/$defs/HealthReportResponse"
      }
    },
    "notes.pick": {
      "summary": "Fuzzy-find notes by title and alias.",
      "params": {
        "$ref": "#/$defs/NotesPickParams"
      },
      "result": {
        "$ref": "#/$defs/NotesPickResult"
      },
      "request": {
        "$ref": "#/$defs/NotesPickRequest"
      },
      "response": {
        "$ref": "#/$defs/NotesPickResponse"
      }
    },
    "note.get": {
      "summary": "Properties, tags, headings, blocks and links in/out of one note.",
      "params": {
        "$ref": "#/$defs/NoteGetParams"
      },
      "result": {
        "$ref": "#/$defs/NoteGetResult"
      },
      "request": {
        "$ref": "#/$defs/NoteGetRequest"
      },
      "response": {
        "$ref": "#/$defs/NoteGetResponse"
      }
    }
  },
  "x-errors": {
    "-32700": "Parse error",
    "-32600": "Invalid Request",
    "-32601": "Method not found",
    "-32602": "Invalid params",
    "-32603": "Internal error",
    "-32001": "Index not built",
    "-32002": "Note not found"
  },
  "$defs": {
