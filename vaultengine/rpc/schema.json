      "properties": {
        "jsonrpc": {
          "const": "2.0",
          "title": "Jsonrpc",
          "type": "string"
        },
        "method": {
          "const": "health.report",
          "title": "Method",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/HealthReportParams"
        },
        "id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
